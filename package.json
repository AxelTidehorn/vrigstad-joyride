{
  "name": "vrigstad-joyride",
  "private": true,
  "description": "Open-world driving game set in Vrigstad, Sweden",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/build.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "data": "python3 tools/process.py data/raw data/vrigstad.json",
    "test:e2e": "playwright test",
    "test:driving": "node tests/driving-v4.mjs",
    "test:vehicles": "node tests/vehicle-glb-integration.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/three": "0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
